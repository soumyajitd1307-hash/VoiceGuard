# VoiceGuard Environment Configuration
# API Service Layer & WebSocket Endpoints
#
# Local development defaults (two local uvicorn processes):
#   Backend 4: python -m uvicorn backend.app:app --port 8000
#   Backend 1: python -m uvicorn backend1.app:app --port 8001
#
# Production (GitHub Pages -> ONE Render service): set these to the deployed
# backend origin, e.g. VITE_API_BASE_URL=https://<service>.onrender.com/api/v1
# and the wss:// equivalents below. Never commit the real URL with secrets;
# for CI, provide them as GitHub Actions variables/secrets (see
# .github/workflows/deploy.yml).

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/calls
VITE_ENABLE_DEMO_MODE=true
VITE_DEFAULT_CALL_ID=1042

# Backend 1 — live audio ingest (separate from the risk WebSocket above)
VITE_AUDIO_WS_URL=ws://localhost:8001/ws/audio

# Backend 1 — two-person WebRTC signaling (SDP/ICE envelopes only, no media)
VITE_SIGNAL_WS_URL=ws://localhost:8001/ws/signal

# ---- Unified cloud backend (Render) ----
# PORT is injected by Render; the container binds 0.0.0.0:$PORT.
# PORT=8000
# Loopback URL the B1 pipeline driver uses to reach B4 in the same process.
# Leave unset to default to http://127.0.0.1:<PORT>/api/v1 automatically.
# B4_BASE_URL=
# Public frontend origin(s) allowed by CORS (comma-separated extras).
# FRONTEND_ORIGIN=https://soumyajitd1307-hash.github.io
# CORS_ORIGINS=
# Demo-grade runtime (see docs/DEPLOYMENT.md). Do NOT set VG_ENV=production
# unless sqlite storage + non-disabled auth are configured (it fail-closes).
# VG_ENV=development
# VG_STORAGE_BACKEND=memory
# VG_AUTH_MODE=disabled
